{
  "name": "codex-img-cli",
  "version": "1.0.0",
  "description": "Reuse your Codex/ChatGPT subscription to give any agent GPT-Image generation and editing, as a CLI and an MCP stdio server.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "codex-img": "bin/codex-img.mjs"
  },
  "main": "src/cli.mjs",
  "exports": {
    ".": "./src/cli.mjs",
    "./client": "./src/client.mjs",
    "./auth": "./src/auth.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xurunxin/codex-img-cli.git"
  },
  "homepage": "https://github.com/xurunxin/codex-img-cli#readme",
  "bugs": {
    "url": "https://github.com/xurunxin/codex-img-cli/issues"
  },
  "author": "xurunxin",
  "keywords": [
    "codex",
    "chatgpt",
    "gpt-image",
    "image-generation",
    "mcp",
    "model-context-protocol",
    "agent",
    "ai",
    "cli"
  ]
}
